{
  "manifest_version": 3,
  "name": "Falcon New Tab",
  "version": "3.0.0",
  "description": "Falcon - Modern/Flexible/Customizable Tab with custom links, Bookmarks in a single view, drag-drop widgets, sorted RSS news, weather and much more.",
  "permissions": [
    "storage",
    "topSites",
    "bookmarks",
    "notifications"
  ],
  "chrome_url_overrides": {
    "newtab": "dashboard.html"
  },

  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "settings.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}